SESSION_SECRET=change-this-to-a-long-random-secret

# PostgreSQL. If this is not set, the app falls back to data/db.json.
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional. Set PGSSL=false only for a local PostgreSQL server.
PGSSL=true

# Cloudinary. If these are not set, images fall back to public/uploads.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional. Comma-separated usernames. If empty, user id 1 is treated as admin.
ADMIN_USERNAMES=your_admin_username

# Optional. Only set true if your hosting proxy and HTTPS setup are correct.
COOKIE_SECURE=false
